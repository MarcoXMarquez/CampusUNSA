# ==============================================================================
# CampusUNSA: Environment Configuration Template
# Copy this file to .env before starting Docker Compose
# ==============================================================================

# Project Identification
PROJECT_NAME="CampusUNSA"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="campusunsa"

# In-Memory Cache & Message Broker (Redis 7)
REDIS_HOST="redis"
REDIS_PORT=6379

# Backend Application (FastAPI)
BACKEND_PORT=9000
API_V1_STR="/api/v1"
SECRET_KEY="temporary_development_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend PWA (Next.js 14)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:9000/api/v1"

# Messaging Gateway (Evolution API)
EVOLUTION_PORT=9080
EVOLUTION_API_KEY="dev_evolution_secret_key_12345"
