# ==============================================================================
# CampusUNSA: Environment Configuration Template
# Copy this file to .env before starting Docker Compose
# ==============================================================================

# Project Identification
PROJECT_NAME="CampusUNSA"
ENVIRONMENT="development"

# Lost and found media: private Supabase bucket and server-side legacy service_role key.
LOST_FOUND_STORAGE_URL=
LOST_FOUND_STORAGE_BUCKET=lost-found
LOST_FOUND_STORAGE_SERVICE_KEY=
# Optional in development/testing. Use a writable, persistent directory.
LOST_FOUND_MEDIA_DIR=
DEBUG=True

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="campusunsa"

# In-Memory Cache & Message Broker (Redis 7)
REDIS_HOST="redis"
REDIS_PORT=6379

# Backend Application (FastAPI)
BACKEND_PORT=9000
API_V1_STR="/api/v1"
SECRET_KEY="temporary_development_secret_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend PWA (Next.js 14)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:9000/api/v1"

# Messaging Gateway (Evolution API)
EVOLUTION_PORT=9080
# For existing Evolution installations in the shared public schema, set this to public before upgrading.
EVOLUTION_DATABASE_SCHEMA=evolution
EVOLUTION_API_KEY="dev_evolution_secret_key_12345"
# Independent inbound secret. Configure the same value in the per-instance webhook apikey header.
EVOLUTION_WEBHOOK_API_KEY=""
EVOLUTION_INSTANCE_NAME="campusunsa"
EVOLUTION_API_URL="http://evolution-api:8080"
WHATSAPP_TASK_WORKER_ENABLED=true

# US-10 structured task extraction. Enable a provider explicitly; no paid calls by default.
TASK_PARSER_PROVIDER="disabled"
TASK_PARSER_MODEL=""
TASK_PARSER_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL="http://ollama:11434"
GEMINI_API_KEY=""

# Optional Telegram webhook and pairing settings
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
