#!/usr/bin/env bash
# ==============================================================================
# CampusUNSA — Pre-Push Quality Gate
# Enforces: Absolute prohibition of Force Pushes (--force, -f) on all branches.
# ==============================================================================

set -eo pipefail

remote="$1"
url="$2"

zero_oid="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
    # Branch deletion guard: Never delete main
    if [ "$local_oid" = "$zero_oid" ]; then
        if [ "$remote_ref" = "refs/heads/main" ]; then
            echo "============================================================" >&2
            echo " [ABORT] Deleting the main branch is strictly prohibited." >&2
            echo "============================================================" >&2
            exit 1
        fi
        continue
    fi

    # Non-fast-forward guard: Block force pushes on any branch
    if [ "$remote_oid" != "$zero_oid" ]; then
        if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
            echo "" >&2
            echo "============================================================" >&2
            echo " [ABORT] Force-push rejected on $remote_ref!" >&2
            echo " Non-fast-forward update or --force flag is strictly prohibited." >&2
            echo " Never rewrite published history or use force flags in CampusUNSA." >&2
            echo "============================================================" >&2
            exit 1
        fi
    fi
done

exit 0
