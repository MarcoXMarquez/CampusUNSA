#!/usr/bin/env bash
# ==============================================================================
# CampusUNSA — Local Commit Message Quality Gate
# Enforces: Conventional Commits standard and Zero-Emoji policy.
# Supports semantic types: feat, fix, docs, test, refactor, perf, ci, chore.
# ==============================================================================

set -eo pipefail

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# Read the first non-comment line
COMMIT_TITLE=$(grep -v '^#' "$COMMIT_MSG_FILE" | head -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$COMMIT_TITLE" ]; then
    echo "============================================================"
    echo " [ABORT] Commit message cannot be empty."
    echo "============================================================"
    exit 1
fi

# Allow merge commits
if [[ "$COMMIT_TITLE" =~ ^Merge.* ]]; then
    exit 0
fi

# 1. Zero-Emoji Check on Commit Message
EMOJI_REGEX='[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{1F700}-\x{1F77F}\x{1F780}-\x{1F7FF}\x{1F800}-\x{1F8FF}\x{1F900}-\x{1F9FF}\x{1FA00}-\x{1FA6F}\x{1FA70}-\x{1FAFF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}]'
if grep -P -q "$EMOJI_REGEX" "$COMMIT_MSG_FILE" 2>/dev/null; then
    echo "============================================================"
    echo " [ABORT] Emoji detected in commit message!"
    echo " CampusUNSA enforces an absolute Zero-Emoji policy."
    echo " Please remove all emojis from your commit message."
    echo "============================================================"
    exit 1
fi

# 2. Conventional Commits Regex
# Allowed types: feat, fix, docs, test, refactor, perf, ci, chore, style, build, revert
CONVENTIONAL_REGEX='^(feat|fix|docs|test|refactor|perf|ci|chore|style|build|revert)(\([a-z0-9_\-\/]+\))?: [a-z0-9].+$'

if ! echo "$COMMIT_TITLE" | grep -P -q "$CONVENTIONAL_REGEX"; then
    echo "============================================================"
    echo " [ABORT] Invalid commit message format."
    echo " Commit: '$COMMIT_TITLE'"
    echo ""
    echo " Expected format:"
    echo "   <type>(<scope>): <concise description in lowercase>"
    echo "   or"
    echo "   <type>: <concise description in lowercase>"
    echo ""
    echo " Valid semantic types:"
    echo "   - feat:     New features or user stories"
    echo "   - fix:      Bug fixes or error corrections"
    echo "   - docs:     Documentation changes only (wikis, markdown)"
    echo "   - test:     Adding or correcting unit/integration tests"
    echo "   - refactor: Code changes without modifying external behavior"
    echo "   - perf:     Performance optimizations and latencies"
    echo "   - ci:       CI/CD pipelines and GitHub Actions workflows"
    echo "   - chore:    Maintenance tasks, dependencies, setup scripts"
    echo ""
    echo " Examples:"
    echo "   feat(auth): validate institutional unsa email domain"
    echo "   docs(wiki): establish initial oppia-caliber knowledge base"
    echo "   fix(dutic): resolve ssl handshake timeout with 2026b moodle"
    echo "   test(rbac): add unit test for secretarial queue authorization"
    echo "============================================================"
    exit 1
fi

exit 0
