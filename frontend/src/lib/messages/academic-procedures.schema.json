{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusUNSA undergraduate procedure guides",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "procedures"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "procedures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/procedure"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://([a-z0-9-]+\\.)*unsa\\.edu\\.pe/"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "links"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "prerequisites",
        "forms",
        "sources",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  }
}
