  "dynamic_heuristics": {
    "path_rules": [
      {
        "pattern": "backend/app/api/v1/auth.*|backend/app/core/security.*",
        "category": "security_and_auth",
        "target_page_fallback": "Auth-and-Institutional-SSO.md"
      },
      {
        "pattern": "backend/app/services/classroom.*",
        "category": "academic_hub",
        "target_page_fallback": "Google-Classroom-Sync-Service.md"
      },
      {
        "pattern": "backend/app/services/dutic.*",
        "category": "academic_hub",
        "target_page_fallback": "DUTIC-Moodle-Extraction-Service.md"
      },
      {
        "pattern": "backend/app/services/task_.*",
        "category": "messaging_and_nlp",
        "target_page_fallback": "NLP-Task-Parser-and-LLM-Pipelines.md"
      },
      {
        "pattern": "backend/app/models/ticket.*|backend/app/api/v1/tickets.*",
        "category": "student_guidance",
        "target_page_fallback": "Secretarial-Helpdesk-and-Ticketing.md"
      },
      {
        "pattern": "frontend/.*",
        "category": "architecture_and_core",
        "target_page_fallback": "Frontend-Architecture-and-PWA.md"
      },
      {
        "pattern": "backend/tests/.*|frontend/src/__tests__/.*|scripts/verify.*",
        "category": "testing_and_qa",
        "target_page_fallback": "Backend-Tests-Guide.md"
      },
      {
        "pattern": "docker-compose.*|Dockerfile.*|backend/alembic/.*",
        "category": "operations_and_devops",
        "target_page_fallback": "Docker-Environment-and-Tooling.md"
      }
    ],
